#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&lt { tapping-term-ms = <140>; };

/ {
    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    macros {
        shift_mo1: shift_mo1 {
            compatible = "zmk,behavior-macro";
            label = "SHIFT_MO1";
            #binding-cells = <0>;
            bindings =
                <&macro_press &mo 1 &kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release &mo 1 &kp LSHFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_mb2 {
            bindings = <&mkp MB2>;
            key-positions = <6 7>;
            timeout-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //---------------------------------------------------------------------------
        //|  Q  |  W  |  E  |  R  |  T  | ESC |.|.....|  Y  |  U  |  I  |  O  |  P  |
        //|  A  |  S  |  D  |  F  |  G  | MB3 |.|.....|  H  |  J  |  K  |  L  | -_  |
        //|  Z  |  X  |  C  |  V  |  B  |SPACE|.|BACKS|  N  |  M  | ,<  | .>  | /?  |
        //|L_ALT|.....|.....|S/TAB|S+mo1|L_CTL|.| MB1 |&mo_1|S/ALT|.....|.....|S/ENT|
        //---------------------------------------------------------------------------

        default_layer {
            bindings = <
&kp Q     &kp W          &kp E       &kp R      &kp T     &kp ESC    &kp Y  &kp U           &kp I            &kp O    &kp P
&kp A     &kp S          &kp D       &kp F      &kp G     &mkp MB3   &kp H  &kp J           &kp K            &kp L    &kp MINUS
&kp Z     &kp X          &kp C       &kp V      &kp B     &kp SPACE  &kp N  &kp M           &kp COMMA        &kp DOT  &kp SLASH
&kp LALT  &mt LSHFT TAB  &shift_mo1  &kp LCTRL  &kp BSPC  &mkp MB1   &mo 1  &mt RSHFT RALT  &mt RSHFT ENTER
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        //---------------------------------------------------------------------------
        //| 1!  | 2@  | 3#  | 4$  | 5%  |_____|.|.....| ;:  | UP  | [{  | ]}  |\\\| |
        //| 6^  | 7&  | 8*  | 9(  | 0)  |_____|.|.....|LEFT |DOWN |RIGHT| =+  |_____|
        //| F11 |     |     |PRI_S|&mo_2|_____|.|DELET| `~  | '"  |_____|_____|_____|
        //|_____|.....|.....|_____|&none|_____|.|_____|&none|_____|.....|.....|_____|
        //---------------------------------------------------------------------------

        symbol_layer {
            bindings = <
&kp N1   &kp N2  &kp N3  &kp N4           &kp N5   &trans  &kp SEMI   &kp UP    &kp LBKT   &kp RBKT   &kp BSLH
&kp N6   &kp N7  &kp N8  &kp N9           &kp N0   &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &kp EQUAL  &trans
&kp F11  &none   &none   &kp PRINTSCREEN  &mo 2    &trans  &kp GRAVE  &kp SQT   &trans     &trans     &trans
&trans   &trans  &none   &trans           &kp DEL  &trans  &none      &trans    &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        //---------------------------------------------------------------------------
        //| F1  | F2  | F3  | F4  | F5  |_____|.|.....|     |_____|STUDI|RESET|BOOT |
        //| F6  | F7  | F8  | F9  | F10 |_____|.|.....|_____|_____|_____|     |     |
        //| F11 | F12 | BT1 | BT0 |&none|_____|.|BACKS| BT2 | BT3 | BT4 |BT_C |BT_CA|
        //|_____|.....|.....|_____|&none|_____|.|_____|&none|_____|.....|.....|_____|
        //---------------------------------------------------------------------------

        functional_layer {
            bindings = <
&kp F1   &kp F2   &kp F3        &kp F4        &kp F5    &trans  &none         &trans        &studio_unlock  &sys_reset  &bootloader
&kp F6   &kp F7   &kp F8        &kp F9        &kp F10   &trans  &trans        &trans        &trans          &none       &none
&kp F11  &kp F12  &bt BT_SEL 1  &bt BT_SEL 0  &none     &trans  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &bt BT_CLR_ALL
&trans   &trans   &none         &trans        &kp BSPC  &trans  &none         &trans        &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };
    };
};
