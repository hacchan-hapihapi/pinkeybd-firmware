#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&lt { tapping-term-ms = <140>; };

/ {
    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        hold_to: hold_to {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TO";
            bindings = <&to>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            quick-tap-ms = <0>;
        };
    };

    macros {
        shift_mo1: shift_mo1 {
            compatible = "zmk,behavior-macro";
            label = "SHIFT_MO1";
            #binding-cells = <0>;
            bindings =
                <&macro_press &mo 1 &kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release &mo 1 &kp LSHFT>;
        };

        shift_mo3: shift_mo3 {
            compatible = "zmk,behavior-macro";
            label = "SHIFT_MO3";
            #binding-cells = <0>;
            bindings =
                <&macro_press &mo 3 &kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release &mo 3 &kp LSHFT>;

        };
    };

    keymap {
        compatible = "zmk,keymap";

        //---------------------------------------------------------------------------
        //|  Q  |  W  |  E  |  R  |  T  | ESC |.|.....|  Y  |  U  |  I  |  O  |  P  |
        //|  A  |  S  |  D  |  F  |  G  | MB3 |.|.....|  H  |  J  |  K  |  L  | -_  |
        //|  Z  |  X  |  C  |  V  |  B  |SPACE|.|BACKS|  N  |  M  | ,<  | .>  | /?  |
        //|L_ALT|.....|.....|S/TAB|S+mo1|L_CTL|.| MB1 |&mo_1|S/ALT|.....|.....|S/ENT|
        //---------------------------------------------------------------------------

        default_layer {
            bindings = <
&kp Q     &kp W          &kp E       &kp R      &kp T     &kp ESC    &kp Y  &kp U           &kp I            &kp O    &kp P
&kp A     &kp S          &kp D       &kp F      &kp G     &mkp MB3   &kp H  &kp J           &kp K            &kp L    &kp MINUS
&kp Z     &kp X          &kp C       &kp V      &kp B     &kp SPACE  &kp N  &kp M           &kp COMMA        &kp DOT  &kp SLASH
&kp LALT  &mt LSHFT TAB  &shift_mo1  &kp LCTRL  &kp BSPC  &mkp MB1   &mo 1  &mt RSHFT RALT  &mt RSHFT ENTER
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        //---------------------------------------------------------------------------
        //| 1!  | 2@  | 3#  | 4$  | 5%  |_____|.|.....| MB2 | UP  | [{  | ]}  | =+  |
        //| 6^  | 7&  | 8*  | 9(  | 0)  |_____|.|.....|LEFT |DOWN |RIGHT| ;:  |_____|
        //| F11 |\\\| | `~  |PRI_S|&mo_4|_____|.|_____|DELET| '"  |_____|_____|_____|
        //|_____|.....|.....|_____|h-to2|_____|.|_____|&mo_1|_____|.....|.....|_____|
        //---------------------------------------------------------------------------

        momentary_movement_layer {
            bindings = <
&kp N1   &kp N2    &kp N3        &kp N4           &kp N5  &trans  &mkp MB2  &kp UP    &kp LBKT   &kp RBKT  &kp EQUAL
&kp N6   &kp N7    &kp N8        &kp N9           &kp N0  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp SEMI  &trans
&kp F11  &kp BSLH  &kp GRAVE     &kp PRINTSCREEN  &mo 4   &trans  &kp DEL   &kp SQT   &trans     &trans    &trans
&trans   &trans    &hold_to 2 0  &trans           &trans  &trans  &mo 1     &trans    &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        //---------------------------------------------------------------------------
        //| 1!  | 2@  | 3#  | 4$  | 5%  |_____|.|.....| MB2 | UP  | [{  | ]}  | =+  |
        //| 6^  | 7&  | 8*  | 9(  | 0)  |_____|.|.....|LEFT |DOWN |RIGHT| ;:  |_____|
        //| F11 |\\\| | `~  |PRI_S|&mo_4|_____|.|_____|DELET| '"  |_____|_____|_____|
        //|_____|.....|.....|_____|S+mo3|_____|.|_____|&mo_3|_____|.....|.....|_____|
        //---------------------------------------------------------------------------

        movement_layer {
            bindings = <
&kp N1   &kp N2    &kp N3      &kp N4           &kp N5  &trans  &mkp MB2  &kp UP    &kp LBKT   &kp RBKT  &kp EQUAL
&kp N6   &kp N7    &kp N8      &kp N9           &kp N0  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp SEMI  &trans
&kp F11  &kp BSLH  &kp GRAVE   &kp PRINTSCREEN  &mo 4   &trans  &kp DEL   &kp SQT   &trans     &trans    &trans
&trans   &trans    &shift_mo3  &trans           &trans  &trans  &mo 3     &trans    &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        //---------------------------------------------------------------------------
        //|  Q  |  W  |  E  |  R  |  T  |_____|.|.....|  Y  |  U  |  I  |  O  |  P  |
        //|  A  |  S  |  D  |  F  |  G  |_____|.|.....|  H  |  J  |  K  |  L  |_____|
        //|  Z  |  X  |  C  |  V  |  B  |_____|.|_____|  N  |  M  |_____|_____|_____|
        //|_____|.....|.....|_____|h-to0|_____|.|_____|&mo_3|_____|.....|.....|_____|
        //---------------------------------------------------------------------------

        alphabet_layer {
            bindings = <
&kp Q   &kp W   &kp E         &kp R   &kp T   &trans  &kp Y  &kp U   &kp I   &kp O   &kp P
&kp A   &kp S   &kp D         &kp F   &kp G   &trans  &kp H  &kp J   &kp K   &kp L   &trans
&kp Z   &kp X   &kp C         &kp V   &kp B   &trans  &kp N  &kp M   &trans  &trans  &trans
&trans  &trans  &hold_to 0 0  &trans  &trans  &trans  &to 3  &trans  &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        //---------------------------------------------------------------------------
        //| F1  | F2  | F3  | F4  | F5  |_____|.|.....|     |     |     |STUDI| BT2 |
        //| F6  | F7  | F8  | F9  | F10 |_____|.|.....|     |     |     |RESET|BT_C |
        //| F11 | F12 | BT0 | BT1 |(L4) |_____|.|_____|     |     |     |BOOT |BT_CA|
        //|_____|.....|.....|_____|&to_0|_____|.|_____|&to_0|_____|.....|.....|_____|
        //---------------------------------------------------------------------------

        function_layer {
            bindings = <
&kp F1   &kp F2   &kp F3        &kp F4        &kp F5   &trans  &none  &none   &none   &studio_unlock  &bt BT_SEL 2
&kp F6   &kp F7   &kp F8        &kp F9        &kp F10  &trans  &none  &none   &none   &sys_reset      &bt BT_CLR
&kp F11  &kp F12  &bt BT_SEL 0  &bt BT_SEL 1  &mo 4    &trans  &none  &none   &none   &bootloader     &bt BT_CLR_ALL
&trans   &trans   &to 0         &trans        &trans   &trans  &to 0  &trans  &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };
    };
};
